# ── App ──────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production

# ── MongoDB ───────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=indus11

# ── Neo4j ─────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── OpenAI ────────────────────────────────────────
# Set to "openai" for OpenAI API, or "ollama" to use local Ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434

# ── ChromaDB ─────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Risk Thresholds ───────────────────────────────
REVIEW_THRESHOLD=40
BLOCK_THRESHOLD=70
