# ── App ──────────────────────────────────────────
APP_ENV=development
# Doubles as the API key required in the X-API-Key header for the
# decision-override, blacklist-toggle, and graph-label-propagation routes.
APP_SECRET_KEY=change-me-in-production

# Comma-separated origins allowed to call the API from a browser (the
# dashboard's dev ports by default). Never set this to "*" in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# ── MongoDB ───────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=indus11

# ── Neo4j ─────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── OpenAI ────────────────────────────────────────
# Set to "openai" for OpenAI API, or "ollama" to use local Ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434

# ── ChromaDB ─────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Risk Thresholds ───────────────────────────────
REVIEW_THRESHOLD=40
BLOCK_THRESHOLD=70
