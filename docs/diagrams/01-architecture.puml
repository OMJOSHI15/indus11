@startuml
skinparam dpi 200
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam rectangle {
  BorderColor #2F4F6F
  BackgroundColor #F4F7FB
}
title Indus11 — Five-Layer Analysis Pipeline
rectangle "React Dashboard\n(analyst UI)" as UI #E8F0FE
rectangle "**LAYER 1** — FastAPI Gateway\nvalidate payload · load account profile\n(Redis → MongoDB)" as L1 #DCEEF5
rectangle "**LAYER 2**\nRule Engine\nvelocity · amount · blacklist\nmerchant · risk tier\n**score 0–40**" as L2
rectangle "**LAYER 3**\nGraph Analyzer\nshared device/IP · circular flow\nfee-skimming mule chains\n**score 0–30**" as L3
rectangle "**LAYER 4**\nRAG Pipeline\nChromaDB retrieval\nLLM score + explanation\n**score 0–30**" as L4
rectangle "**LAYER 5** — Decision Engine\ncomposite = min(rule + graph + rag, 100)\n0–39 APPROVE   |   40–69 REVIEW   |   70+ BLOCK" as L5 #DCEEF5
database "MongoDB\nprofiles + audit" as M
database "Neo4j\ntransaction graph" as N
database "Redis\ncache + velocity" as R
database "ChromaDB\nknowledge base" as C
UI -down-> L1 : HTTP / JSON
L1 -down-> L2
L1 -down-> L3
L1 -down-> L4
note right of L1 : run concurrently\nasyncio.gather()
L2 -down-> L5
L3 -down-> L5
L4 -down-> L5
L5 -down-> M : persist + respond
L1 -left-> R
L3 -right-> N
L4 -right-> C
@enduml
