@startuml
!include _theme.iuml
title Component Diagram — Indus11
component "Analyst Dashboard\n(React + Vite)" as UI
() "REST /api/v1" as REST
package "FastAPI application" {
  component "Middleware\nCORS · slowapi rate limit" as MW
  component "Routers\ntransactions · accounts\ngraph · stats · health" as RT
  component "API-key guard\nrequire_api_key" as KEY
  component "Rule Engine" as RE
  component "Graph Analyzer" as GA
  component "Decision Engine" as DE
  component "Background tasks\n4 concurrent · 180 s timeout" as BG
  component "RAG Pipeline" as RP
  component "Beanie ODM models\nAccount · Transaction" as ODM
}
database "Redis" as R
database "Neo4j" as N
database "ChromaDB" as C
database "MongoDB" as M
component "Ollama\nLlama 3" as OL <<external>>

UI --> REST
REST - MW
MW --> RT
RT ..> KEY : override, blacklist,\nlabel propagation
RT --> RE : run_rule_engine()
RT --> GA : run_graph_analyzer()
RT --> DE : make_decision()
RT --> BG : add_task()
BG --> RP : run_rag_pipeline()
BG --> DE : make_decision()
RT --> ODM
BG --> ODM
RT --> R : profile cache
RE --> R : velocity window
GA --> N : Cypher over Bolt
RP --> C : 3 nearest patterns
RP --> OL : HTTP :11434
ODM --> M
@enduml
