@startuml
!include _theme.iuml
title Deployment Diagram — Docker Compose
node "Analyst workstation" as CD {
  artifact "Web browser" as BR
}
node "Docker host" as DH {
  node "container: dashboard" as CDash {
    artifact "nginx :80\nReact build\nproxies /api/ to api:8000" as NG
  }
  node "container: api" as CApi {
    artifact "uvicorn :8000\nFastAPI\nseeds MongoDB and Neo4j on start" as UV
  }
  node "container: mongo" as CM {
    database "MongoDB 7 :27017\nvolume mongo_data" as M
  }
  node "container: neo4j" as CN {
    database "Neo4j 5.20 :7687, :7474\nvolume neo4j_data" as N
  }
  node "container: redis" as CR {
    database "Redis 7.2 :6379\nvolume redis_data" as R
  }
  artifact "bind mount ./data/chroma\nChromaDB files" as CH
}
node "Host, outside Docker" as HM {
  artifact "Ollama :11434\nLlama 3" as OL
}
CApi -[hidden]right- HM
BR --> NG : HTTP, host port 5173
NG --> UV : /api/
UV --> M
UV --> N : Bolt
UV --> R
UV --> CH : file I/O
UV --> OL : host.docker.internal:11434
CM -[hidden]right- CN
CN -[hidden]right- CR
@enduml
