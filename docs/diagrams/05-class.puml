@startuml
skinparam dpi 200
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 13
skinparam linetype ortho
skinparam class {
  BorderColor #2F4F6F
  BackgroundColor #F7FAFF
  FontName Times New Roman
  AttributeFontName Times New Roman
  AttributeFontSize 12
}
title Class Diagram — Core Domain and Service Classes
enum Decision {
  APPROVE
  REVIEW
  BLOCK
}
class TransactionRequest {
  - tx_id : String
  - sender_account_id : String
  - receiver_account_id : String
  - amount : Float
  - currency : String
  - merchant_category : String
  - device_id : String
  - ip_address : String
  + validate() : Boolean
}
class LayerScore {
  - score : Integer
  - max_score : Integer
  - flags : List<String>
  + is_maximum() : Boolean
}
class AnalysisResponse {
  - tx_id : String
  - decision : Decision
  - composite_score : Integer
  - explanation : String
  - processing_time_ms : Float
}
class Account {
  - account_id : String
  - owner_name : String
  - country_code : String
  - avg_monthly_transaction : Float
  - is_blacklisted : Boolean
  - risk_tier : String
  + is_high_risk() : Boolean
}
class Transaction {
  - tx_id : String
  - amount : Float
  - composite_score : Integer
  - decision : String
  - explanation : String
  - created_at : DateTime
  + override_decision(d : Decision) : void
}
abstract class AnalysisLayer {
  # max_score : Integer
  + {abstract} analyse(tx : TransactionRequest) : LayerScore
}
class RuleEngine {
  - VELOCITY_LIMIT : Integer
  - AMOUNT_MULTIPLIER : Float
  + analyse(tx : TransactionRequest) : LayerScore
}
class GraphAnalyzer {
  + analyse(tx : TransactionRequest) : LayerScore
  + propagate_fraud_labels() : Integer
}
class RagPipeline {
  + analyse(tx : TransactionRequest) : LayerScore
  + build_explanation() : String
}
class DecisionEngine {
  - review_threshold : Integer
  - block_threshold : Integer
  + make_decision(scores : List<LayerScore>) : AnalysisResponse
}
AnalysisLayer <|-- RuleEngine
AnalysisLayer <|-- GraphAnalyzer
AnalysisLayer <|-- RagPipeline
AnalysisLayer ..> LayerScore : creates
DecisionEngine o-- "3" LayerScore : aggregates
DecisionEngine ..> AnalysisResponse : creates
AnalysisResponse --> Decision : has
DecisionEngine ..> TransactionRequest : reads
Account "1" -- "0..*" Transaction : sends
Account "1" -- "0..*" Transaction : receives
TransactionRequest ..> Transaction : persisted as
RuleEngine ..> Account : reads profile
@enduml
