@startuml
skinparam dpi 200
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
title Data Flow Diagram — Level 1
rectangle "Client" as C #E8F0FE
usecase "1.0\nValidate\nRequest" as P1
usecase "2.0\nLoad Account\nProfiles" as P2
usecase "3.0\nApply Rules" as P3
usecase "4.0\nAnalyse Graph" as P4
usecase "5.0\nRetrieve &\nExplain" as P5
usecase "6.0\nDecide" as P6
usecase "7.0\nPersist\nAnalysis" as P7
usecase "8.0\nReturn\nResponse" as P8
database "Redis cache" as R
database "MongoDB" as M
database "Neo4j" as N
database "ChromaDB" as CH
C -down-> P1 : transaction
P1 -down-> P2 : validated tx
R -right-> P2 : cached profile
M -right-> P2 : stored profile
P2 -down-> P3 : tx + profiles
P2 -down-> P4 : tx + profiles
P2 -down-> P5 : tx + profiles
N -right-> P4 : graph patterns
CH -right-> P5 : similar patterns
P3 -down-> P6 : score 0–40 + flags
P4 -down-> P6 : score 0–30 + flags
P5 -down-> P6 : score 0–30 + reason
P6 -down-> P7 : decision record
P6 -down-> P8 : decision + explanation
P7 -right-> M : insert
P8 -down-> C : JSON response
@enduml
