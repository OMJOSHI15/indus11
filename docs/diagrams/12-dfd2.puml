@startuml
skinparam dpi 200
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
title Data Flow Diagram — Level 2 (Process 3.0, Rule Engine)
rectangle "transaction +\nsender & receiver profiles" as IN #E8F0FE
usecase "3.1\nCheck\nblacklist" as A
usecase "3.2\nCheck velocity\n(Redis sorted set)" as B
usecase "3.3\nCheck amount\nanomaly" as C2
usecase "3.4\nCheck merchant\ncategory" as D
usecase "3.5\nCheck sender\nrisk tier" as E
rectangle "LayerScore\nscore = min(total, 40)\n+ flags[]" as OUT #E8F0FE
database "Redis\nvelocity:<account>" as R
IN -down-> A
A -down-> B : not blacklisted
A -right-> OUT : blacklisted → score 40\nBLACKLISTED_ACCOUNT
R -left-> B : rolling 10-min count
B -down-> C2 : +15 if > 5 tx\nVELOCITY_EXCEEDED
C2 -down-> D : +12 if > 3× average\nAMOUNT_ANOMALY
D -down-> E : +8 if high-risk\nHIGH_RISK_MERCHANT
E -down-> OUT : +5 high / +2 elevated\nRISK_TIER
@enduml
