digraph DFD1 {
  graph [rankdir=TB, fontname="Times-Roman", fontsize=14, nodesep=0.5, ranksep=0.75];
  node  [fontname="Times-Roman", fontsize=15];
  edge  [fontname="Times-Roman", fontsize=13];

  CL  [shape=box, style=filled, fillcolor="#EEF3FA", label="Payment Client"];
  AN  [shape=box, style=filled, fillcolor="#EEF3FA", label="Fraud Analyst"];

  P1 [shape=box, style="rounded,filled", fillcolor="#F7FAFF", label="1.0\nValidate\nRequest"];
  P2 [shape=box, style="rounded,filled", fillcolor="#F7FAFF", label="2.0\nLoad Account\nProfiles"];
  P3 [shape=box, style="rounded,filled", fillcolor="#F7FAFF", label="3.0\nEvaluate\nRules"];
  P4 [shape=box, style="rounded,filled", fillcolor="#F7FAFF", label="4.0\nAnalyse\nGraph"];
  P5 [shape=box, style="rounded,filled", fillcolor="#F7FAFF", label="5.0\nRetrieve and\nExplain"];
  P6 [shape=box, style="rounded,filled", fillcolor="#F7FAFF", label="6.0\nDetermine\nDecision"];
  P7 [shape=box, style="rounded,filled", fillcolor="#F7FAFF", label="7.0\nRecord\nAnalysis"];

  D1 [shape=record, style=filled, fillcolor="#FBFBF4", label="{D1|Account Store}"];
  D2 [shape=record, style=filled, fillcolor="#FBFBF4", label="{D2|Profile Cache}"];
  D3 [shape=record, style=filled, fillcolor="#FBFBF4", label="{D3|Transaction Graph}"];
  D4 [shape=record, style=filled, fillcolor="#FBFBF4", label="{D4|Fraud Pattern Base}"];
  D5 [shape=record, style=filled, fillcolor="#FBFBF4", label="{D5|Analysis Records}"];

  CL -> P1 [label=" transaction"];
  P1 -> P2 [label=" validated tx"];
  D2 -> P2 [label=" cached profile"];
  D1 -> P2 [label=" stored profile"];
  P2 -> D2 [label=" profile"];
  P2 -> P3 [label=" tx + profiles"];
  P2 -> P4 [label=" transaction"];
  P2 -> P5 [label=" tx + profiles"];
  D3 -> P4 [label=" related accounts"];
  P4 -> D3 [label=" relationships"];
  D4 -> P5 [label=" patterns"];
  P3 -> P6 [label=" 0-40"];
  P4 -> P6 [label=" 0-30"];
  P5 -> P6 [label=" 0-30"];
  P6 -> P7 [label=" decision"];
  P7 -> D5 [label=" analysis record"];
  P6 -> CL [label=" decision,\l score,\l explanation\l"];
  D5 -> AN [label=" flagged tx"];
  AN -> P7 [label=" override decision"];
}
