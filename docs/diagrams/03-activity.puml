@startuml
!include _theme.iuml
skinparam activity {
  BackgroundColor #0F3B39
  BorderColor #FFFFFF
  FontColor #FFFFFF
  DiamondBackgroundColor #0F3B39
  DiamondBorderColor #FFFFFF
  DiamondFontColor #FFFFFF
  StartColor #FFFFFF
  EndColor #FFFFFF
  BarColor #FFFFFF
}
skinparam swimlane {
  BorderColor #9A9A9A
  TitleFontColor #FFFFFF
}
<style>
activityDiagram {
  circle {
    BackgroundColor #FFFFFF
    LineColor #FFFFFF
  }
}
</style>
title Activity Diagram — Transaction Analysis Workflow
|Payment Client|
start
:Submit transaction;
|API Gateway|
:Validate request;
if (Request well formed?) then (no)
  |Payment Client|
  :Receive 422 rejection;
  stop
else (yes)
endif
|API Gateway|
:Load sender and receiver profiles;
|Analysis Layers|
fork
  :Rule scoring 0–40;
fork again
  :Graph scoring 0–30;
end fork
|Decision Engine|
:Band the rule + graph score;
|API Gateway|
if (tx_id already stored?) then (yes)
  |Payment Client|
  :Receive 409 conflict;
  stop
else (no)
  :Store record, rag_pending = true;
endif
|Payment Client|
:Receive provisional decision;
|Analysis Layers|
:RAG scoring 0–30 with explanation
(background, 180 s limit);
|Decision Engine|
if (Model answered in time?) then (yes)
  :Re-band the composite score;
else (no)
  :Keep the provisional decision;
endif
|API Gateway|
:Update record, rag_pending = false;
|Fraud Analyst|
if (Decision is REVIEW?) then (yes)
  :Inspect transaction;
  :Approve or block;
else (no)
endif
stop
@enduml
