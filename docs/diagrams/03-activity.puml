@startuml
skinparam dpi 200
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 13
skinparam ArrowColor #333333
skinparam activity {
  BorderColor #2F4F6F
  BackgroundColor #F7FAFF
  DiamondBorderColor #2F4F6F
  DiamondBackgroundColor #FBFBF4
}
title Activity Diagram — Transaction Analysis Workflow
|Payment Client|
start
:Submit transaction;
|API Gateway|
:Validate request format;
if (Request well formed?) then (no)
  :Report validation failure;
  |Payment Client|
  :Receive rejection;
  stop
else (yes)
endif
|API Gateway|
:Retrieve sender and receiver profiles;
|Analysis Layers|
fork
  :Evaluate business rules;
fork again
  :Analyse account relationships;
fork again
  :Retrieve similar fraud patterns;
end fork
|Decision Engine|
:Combine layer scores;
if (Risk level?) then (high)
  :Mark as blocked;
elseif (moderate) then
  :Mark for review;
else (low)
  :Mark as approved;
endif
:Compose explanation;
:Store analysis record;
|Payment Client|
:Receive decision and explanation;
|Fraud Analyst|
if (Marked for review?) then (yes)
  :Examine transaction detail;
  :Approve or block manually;
  :Record final outcome;
else (no)
endif
stop
@enduml
