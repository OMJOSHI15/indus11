@startuml
skinparam dpi 200
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 13
skinparam state {
  BorderColor #2F4F6F
  BackgroundColor #F7FAFF
  FontName Times New Roman
}
title State Diagram — Transaction Lifecycle
[*] --> Received : transaction submitted
Received --> Rejected : validation fails
Received --> UnderAnalysis : validation succeeds
state UnderAnalysis {
  [*] --> Scoring
  Scoring : rule, graph and AI layers
  Scoring : evaluate concurrently
  Scoring --> Aggregated : all scores returned
  Aggregated : composite risk score computed
  Aggregated --> [*]
}
UnderAnalysis --> Approved : score below review threshold
UnderAnalysis --> UnderReview : score within review band
UnderAnalysis --> Blocked : score at or above block threshold
UnderReview : awaiting analyst judgement
UnderReview --> Approved : analyst approves
UnderReview --> Blocked : analyst blocks
Approved --> [*]
Blocked --> [*]
Rejected --> [*]
@enduml
